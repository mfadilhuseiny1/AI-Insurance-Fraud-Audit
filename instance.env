# AI JKN Synthetic runs beside the BluesandAI platform it was copied from (API 8000, UI 8888, SQL 5433): everything that
# would collide gets its own value here. api/server.py loads this file into the environment at start (a variable already
# set wins); start.ps1 and .work/koordinasi/restart_api.ps1 use the same ports. No secrets in this file.
BLUESANDAI_API_PORT=8300
BLUESANDAI_INTERNAL_API_URL=http://localhost:8300
BLUESANDAI_API_URL=http://127.0.0.1:8300
BLUESANDAI_PUBLIC_API=http://127.0.0.1:8300
BLUESANDAI_API_PUBLIC_URL=http://localhost:8300
BLUESANDAI_WEB_URL=http://localhost:9300
BLUESANDAI_WEB_ORIGINS=http://localhost:9300,http://127.0.0.1:9300
# PostgreSQL wire-protocol endpoint for BI tools (the platform's is 5433; this app's own database server is 5435)
BLUESANDAI_SQL_PORT=5453
# relays between WSL containers and this API
BLUESANDAI_REGISTRY_RELAY_PORT=5025
BLUESANDAI_CONTAINER_RELAY_PORT=5026
# both apps run on localhost, where browsers share cookies across ports: a sign-in here must not replace the platform's
BLUESANDAI_SESSION_COOKIE=AIJKNSYN_SESSION
# Docker containers and volumes (JupyterLab, VS Code, MQTT) are named aijkn-…, never the platform's bsai-…
BLUESANDAI_CONTAINER_PREFIX=aijknsyn
# AI JKN Synthetic: the synthetic gold tables spread over more groups (indikator_inacbg ~97k rows) than the 50k default
BLUESANDAI_ONTOLOGY_MAX_ROWS=150000
