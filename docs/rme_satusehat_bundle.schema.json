       "type": "string"
      }
     }
    },
    "encounter": {
     "type": "object",
     "properties": {
      "reference": {
       "type": "string"
      },
      "identifier": {
       "type": "object"
      },
      "display": {
       "type": "string"
      }
     }
    }
   },
   "required": [
