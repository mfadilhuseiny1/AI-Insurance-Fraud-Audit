{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://bluesandai.local/schema/rme-satusehat-bundle.json",
 "title": "Rekam medis elektronik per klaim (FHIR R4 Bundle, SATUSEHAT ID Core)",
 "description": "Kontrak rme-1: satu Bundle per klaim, dikirim di field `rekam_medis` pada POST /api/aip/realtime/v1/faskes/klaim. Kemenkes ID Core FHIR IG 0.3.16 (SATUSEHAT), FHIR R4 4.0.1. Resource lain boleh ada dan diabaikan. Batas 3000 entri.",
 "type": "object",
 "properties": {
  "resourceType": {
   "const": "Bundle"
  },
  "type": {
   "enum": [
    "collection",
    "document",
    "transaction",
    "searchset",
    "batch"
   ]
  },
  "entry": {
   "type": "array",
   "maxItems": 3000,
   "contains": {
    "type": "object",
    "properties": {
     "resource": {
      "$ref": "#/$defs/Encounter"
     }
    }
   },
   "items": {
    "type": "object",
    "properties": {
     "fullUrl": {
      "type": "string"
     },
     "resource": {
      "type": "object",
      "properties": {
       "resourceType": {
        "type": "string"
       }
      },
      "required": [
       "resourceType"
      ],
      "allOf": [
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "Patient"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/Patient"
        }
       },
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "Encounter"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/Encounter"
        }
       },
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "Condition"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/Condition"
        }
       },
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "Procedure"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/Procedure"
        }
       },
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "Observation"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/Observation"
        }
       },
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "ServiceRequest"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/ServiceRequest"
        }
       },
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "DiagnosticReport"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/DiagnosticReport"
        }
       },
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "MedicationRequest"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/MedicationRequest"
        }
       },
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "MedicationDispense"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/MedicationDispense"
        }
       },
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "MedicationAdministration"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/MedicationAdministration"
        }
       },
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "Medication"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/Medication"
        }
       },
       {
        "if": {
         "properties": {
          "resourceType": {
           "const": "Device"
          }
         }
        },
        "then": {
         "$ref": "#/$defs/Device"
        }
       }
      ]
     }
    },
    "required": [
     "resource"
    ]
   }
  }
 },
 "required": [
  "resourceType",
  "entry"
 ],
 "$defs": {
  "Coding": {
   "type": "object",
   "properties": {
    "system": {
     "type": "string"
    },
    "code": {
     "type": "string"
    },
    "display": {
     "type": "string"
    }
   },
   "required": [
    "code"
   ]
  },
  "CodeableConcept": {
   "type": "object",
   "properties": {
    "coding": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Coding"
     }
    },
    "text": {
     "type": "string"
    }
   }
  },
  "Patient": {
   "type": "object",
   "description": "Pasien. Dibaca: gender dan birthDate (cek identitas terhadap kepesertaan). NIK dan nama tidak disimpan. Profil: https://fhir.kemkes.go.id/r4/StructureDefinition/id-core-patient",
   "properties": {
    "resourceType": {
     "const": "Patient"
    },
    "id": {
     "type": "string"
    },
    "identifier": {
     "type": "array",
     "contains": {
      "type": "object",
      "properties": {
       "system": {
        "const": "https://fhir.kemkes.go.id/id/patient-ihs-number"
       }
      }
     }
    },
    "gender": {
     "enum": [
      "male",
      "female",
      "other",
      "unknown"
     ]
    },
    "birthDate": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    }
   },
   "required": [
    "resourceType",
    "identifier"
   ]
  },
  "Encounter": {
   "type": "object",
   "description": "Kunjungan yang ditagih. period.start/end = tanggal masuk/pulang; class IMP = rawat inap. Profil: https://fhir.kemkes.go.id/r4/StructureDefinition/id-core-encounter",
   "properties": {
    "resourceType": {
     "const": "Encounter"
    },
    "id": {
     "type": "string"
    },
    "status": {
     "type": "string"
    },
    "class": {
     "type": "object",
     "properties": {
      "system": {
       "const": "http://terminology.hl7.org/CodeSystem/v3-ActCode"
      },
      "code": {
       "enum": [
        "IMP",
        "AMB",
        "EMER",
        "HH",
        "VR",
        "ACUTE",
        "NONAC",
        "SS"
       ]
      }
     },
     "required": [
      "code"
     ]
    },
    "period": {
     "type": "object",
     "properties": {
      "start": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}"
      },
      "end": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}"
      }
     },
     "required": [
      "start"
     ]
    },
    "subject": {
     "type": "object",
     "properties": {
      "reference": {
       "type": "string"
      },
      "identifier": {
       "type": "object"
      },
      "display": {
       "type": "string"
      }
     }
    },
    "diagnosis": {
     "type": "array"
    },
    "classHistory": {
     "type": "array"
    },
    "statusHistory": {
     "type": "array"
    },
    "location": {
     "type": "array"
    }
   },
   "required": [
    "resourceType",
    "status",
    "class",
    "period"
   ]
  },
  "Condition": {
   "type": "object",
   "description": "Diagnosis, kode ICD-10 (http://hl7.org/fhir/sid/icd-10). Condition dengan verificationStatus refuted/entered-in-error diabaikan. Profil: https://fhir.kemkes.go.id/r4/StructureDefinition/id-core-condition",
   "properties": {
    "resourceType": {
     "const": "Condition"
    },
    "id": {
     "type": "string"
    },
    "code": {
     "type": "object",
     "properties": {
      "coding": {
       "type": "array",
       "contains": {
        "type": "object",
        "properties": {
         "system": {
          "const": "http://hl7.org/fhir/sid/icd-10"
         }
        },
        "required": [
         "system",
         "code"
        ]
       }
      }
     },
     "required": [
      "coding"
     ]
    },
    "encounter": {
     "type": "object",
     "properties": {
      "reference": {
       "type": "string"
      },
      "identifier": {
       "type": "object"
      },
      "display": {
       "type": "string"
      }
     }
    },
    "category": {
     "type": "array"
    },
    "verificationStatus": {
     "type": "object",
     "properties": {
      "coding": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Coding"
       }
      },
      "text": {
       "type": "string"
      }
     }
    }
   },
   "required": [
    "resourceType",
    "code"
   ]
  },
  "Procedure": {
   "type": "object",
   "description": "Tindakan, kode ICD-9-CM (http://hl7.org/fhir/sid/icd-9-cm). status not-done = tidak jadi dilakukan. Profil: https://fhir.kemkes.go.id/r4/StructureDefinition/id-core-procedure",
   "properties": {
    "resourceType": {
     "const": "Procedure"
    },
    "id": {
     "type": "string"
    },
    "code": {
     "type": "object",
     "properties": {
      "coding": {
       "type": "array",
       "contains": {
        "type": "object",
        "properties": {
         "system": {
          "const": "http://hl7.org/fhir/sid/icd-9-cm"
         }
        },
        "required": [
         "system",
         "code"
        ]
       }
      }
     },
     "required": [
      "coding"
     ]
    },
    "status": {
     "type": "string"
    },
    "encounter": {
     "type": "object",
     "properties": {
      "reference": {
       "type": "string"
      },
      "identifier": {
       "type": "object"
      },
      "display": {
       "type": "string"
      }
     }
    },
    "performedDateTime": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "performedPeriod": {
     "type": "object",
     "properties": {
      "start": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}"
      },
      "end": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}"
      }
     }
    },
    "focalDevice": {
     "type": "array"
    }
   },
   "required": [
    "resourceType",
    "code",
    "status"
   ]
  },
  "Observation": {
   "type": "object",
   "description": "Tanda vital dan laboratorium, kode LOINC (lihat x-loinc). Tekanan darah boleh panel 85354-9 dengan komponen 8480-6/8462-4. Profil: https://fhir.kemkes.go.id/r4/StructureDefinition/id-core-observation",
   "properties": {
    "resourceType": {
     "const": "Observation"
    },
    "id": {
     "type": "string"
    },
    "code": {
     "type": "object",
     "properties": {
      "coding": {
       "type": "array",
       "contains": {
        "type": "object",
        "properties": {
         "system": {
          "const": "http://loinc.org"
         }
        },
        "required": [
         "system",
         "code"
        ]
       }
      }
     },
     "required": [
      "coding"
     ]
    },
    "status": {
     "type": "string"
    },
    "encounter": {
     "type": "object",
     "properties": {
      "reference": {
       "type": "string"
      },
      "identifier": {
       "type": "object"
      },
      "display": {
       "type": "string"
      }
     }
    },
    "effectiveDateTime": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "effectivePeriod": {
     "type": "object",
     "properties": {
      "start": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}"
      },
      "end": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}"
      }
     }
    },
    "valueQuantity": {
     "type": "object",
     "properties": {
      "value": {
       "type": "number"
      },
      "unit": {
       "type": "string"
      },
      "system": {
       "type": "string"
      },
      "code": {
       "type": "string"
      }
     },
     "required": [
      "value"
     ]
    },
    "valueCodeableConcept": {
     "type": "object",
     "properties": {
      "coding": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Coding"
       }
      },
      "text": {
       "type": "string"
      }
     }
    },
    "valueBoolean": {
     "type": "boolean"
    },
    "interpretation": {
     "type": "array"
    },
    "referenceRange": {
     "type": "array"
    },
    "component": {
     "type": "array"
    }
   },
   "required": [
    "resourceType",
    "code"
   ]
  },
  "ServiceRequest": {
   "type": "object",
   "description": "Permintaan tindakan (ICD-9-CM) atau pemeriksaan. Profil: https://fhir.kemkes.go.id/r4/StructureDefinition/id-core-service-request",
   "properties": {
    "resourceType": {
     "const": "ServiceRequest"
    },
    "id": {
     "type": "string"
    },
    "code": {
     "type": "object",
     "properties": {
      "coding": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Coding"
       }
      },
      "text": {
       "type": "string"
      }
     }
    },
    "encounter": {
     "type": "object",
     "properties": {
      "reference": {
       "type": "string"
      },
      "identifier": {
       "type": "object"
      },
      "display": {
       "type": "string"
      }
     }
    }
   },
   "required": [
    "resourceType",
    "code"
   ]
  },
  "DiagnosticReport": {
   "type": "object",
   "description": "Hasil pemeriksaan penunjang (EKG 11524-6, ekokardiografi 34552-0, angiografi) dengan kesimpulan. Profil: https://fhir.kemkes.go.id/r4/StructureDefinition/id-core-diagnostic-report",
   "properties": {
    "resourceType": {
     "const": "DiagnosticReport"
    },
    "id": {
     "type": "string"
    },
    "code": {
     "type": "object",
     "properties": {
      "coding": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Coding"
       }
      },
      "text": {
       "type": "string"
      }
     }
    },
    "encounter": {
     "type": "object",
     "properties": {
      "reference": {
       "type": "string"
      },
      "identifier": {
       "type": "object"
      },
      "display": {
       "type": "string"
      }
     }
    },
    "conclusion": {
     "type": "string"
    },
    "conclusionCode": {
     "type": "array"
    }
   },
   "required": [
    "resourceType",
    "code"
   ]
  },
  "MedicationRequest": {
   "type": "object",
