# BluesandAI settings. Copy this file to .env.local (same folder) and fill in what you use.
# .env.local is git-ignored; never commit real keys. Every setting can also be an environment variable.

# --------------------------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------------------------
# PostgreSQL holds Files, jobs, data sources, and (optionally) users. setup-database.py writes it for you.
BLUESANDAI_DATABASE_URL=postgresql://bluesandai:change-me@localhost:5432/bluesandai_parse

# --------------------------------------------------------------------------------------------
# Sign-in and security (api/auth.py)
# --------------------------------------------------------------------------------------------
# off: no sign-in at all (development only)
BLUESANDAI_AUTH=on
# where users, sessions, groups, markings and Project roles live: sqlite (data/auth/auth.sqlite) or postgres
# (the schema bsai_auth in BLUESANDAI_DATABASE_URL; an existing auth.sqlite is copied in on the first start)
BLUESANDAI_AUTH_STORE=sqlite
# a separate PostgreSQL database for sign-in data (optional; default: BLUESANDAI_DATABASE_URL)
BLUESANDAI_AUTH_DATABASE_URL=

# The web app's address (links in reset / invitation emails, where single sign-on returns to)
BLUESANDAI_WEB_URL=http://localhost:8888
# The API's address as the browser reaches it (single sign-on redirect / callback URLs)
BLUESANDAI_API_PUBLIC_URL=http://localhost:8000
# 1: send the session cookie over HTTPS only (set when the app is served over HTTPS)
BLUESANDAI_COOKIE_SECURE=0
# 1: behind a reverse proxy, take the client's address from X-Forwarded-For (per-IP sign-in limits, audit log)
BLUESANDAI_TRUST_PROXY=0
# Starting values of Control Panel → Security (changed there afterwards)
BLUESANDAI_IDLE_TIMEOUT_MINUTES=60
BLUESANDAI_PASSWORD_MIN_LENGTH=8
# Fernet key that seals stored secrets (connection passwords, two-factor secrets); default: secrets/connections.key
BLUESANDAI_SECRET_KEY=

# --------------------------------------------------------------------------------------------
# Email (password reset links, invitations, Data Health alert emails) — sent with Resend
# --------------------------------------------------------------------------------------------
# 1. resend.com → API Keys → Create API key (permission "Sending access") → paste it here (starts with re_).
# 2. resend.com → Domains → Add domain, add the DNS records it shows (SPF, DKIM), wait until "Verified".
# 3. RESEND_FROM: an address on that verified domain. Before a domain is verified you can test with
#    "BluesandAI <onboarding@resend.dev>", which only delivers to the email of your own Resend account.
RESEND_API_KEY=
RESEND_FROM=BluesandAI <no-reply@mail.example.com>
# optional: where replies go
RESEND_REPLY_TO=

# Alternatively, any SMTP server (used only when RESEND_API_KEY is empty). Resend's SMTP also works:
# host smtp.resend.com, port 465 (SSL) or 587 (STARTTLS), user "resend", password = the API key.
BLUESANDAI_SMTP_HOST=
BLUESANDAI_SMTP_PORT=587
BLUESANDAI_SMTP_USER=
BLUESANDAI_SMTP_PASSWORD=
BLUESANDAI_SMTP_FROM=
BLUESANDAI_SMTP_STARTTLS=1

# --------------------------------------------------------------------------------------------
# Single sign-on (api/auth_sso.py) — a button appears on the sign-in page for each provider configured.
# Redirect / callback URL to register with an OIDC provider: {BLUESANDAI_API_PUBLIC_URL}/api/auth/sso/<id>/callback
#   (<id> = google, microsoft, okta or oidc). New users are created on first sign-in only when
#   Control Panel → Security → "Create accounts on first sign-in" is on; otherwise invite them first.
# --------------------------------------------------------------------------------------------
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
#   redirect URI http://localhost:8000/api/auth/sso/google/callback
BLUESANDAI_SSO_GOOGLE_CLIENT_ID=
BLUESANDAI_SSO_GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID: entra.microsoft.com → App registrations → New registration (Web platform)
#   redirect URI http://localhost:8000/api/auth/sso/microsoft/callback; Certificates & secrets → New client secret
#   TENANT: your tenant id or domain (contoso.onmicrosoft.com), or "organizations" for any work account
BLUESANDAI_SSO_MICROSOFT_CLIENT_ID=
BLUESANDAI_SSO_MICROSOFT_CLIENT_SECRET=
BLUESANDAI_SSO_MICROSOFT_TENANT=organizations

# Okta: Admin → Applications → Create App Integration → OIDC, Web Application
#   sign-in redirect URI http://localhost:8000/api/auth/sso/okta/callback
#   ISSUER: https://<your-org>.okta.com (or https://<your-org>.okta.com/oauth2/default)
BLUESANDAI_SSO_OKTA_ISSUER=
BLUESANDAI_SSO_OKTA_CLIENT_ID=
BLUESANDAI_SSO_OKTA_CLIENT_SECRET=

# Any other OpenID Connect provider (Keycloak, Auth0, Ping, OneLogin …)
BLUESANDAI_SSO_OIDC_NAME=Company account
BLUESANDAI_SSO_OIDC_ISSUER=
BLUESANDAI_SSO_OIDC_CLIENT_ID=
BLUESANDAI_SSO_OIDC_CLIENT_SECRET=

# SAML 2.0 (ADFS, Entra ID SAML, Okta SAML, Google Workspace SAML …)
#   Give the IdP our metadata: {BLUESANDAI_API_PUBLIC_URL}/api/auth/sso/saml/metadata
#   (ACS URL {BLUESANDAI_API_PUBLIC_URL}/api/auth/sso/saml/acs; NameID: email)
BLUESANDAI_SSO_SAML_NAME=Company account (SAML)
BLUESANDAI_SSO_SAML_IDP_SSO_URL=
BLUESANDAI_SSO_SAML_IDP_ENTITY_ID=
# the IdP's signing certificate: PEM text (\n for line breaks) or a path to a .pem / .crt file
BLUESANDAI_SSO_SAML_IDP_CERT=
# our entity id (default: the metadata URL)
BLUESANDAI_SSO_SAML_SP_ENTITY_ID=
# single logout: the IdP's SLO URL (and where our LogoutResponses go, default the same URL)
BLUESANDAI_SSO_SAML_IDP_SLO_URL=
BLUESANDAI_SSO_SAML_IDP_SLO_RESPONSE_URL=
# how requests go to the IdP: redirect (default) or post
BLUESANDAI_SSO_SAML_IDP_BINDING=
# our signing key + certificate (PEM text or file paths; both or neither — default: a pair generated once and kept)
BLUESANDAI_SSO_SAML_SP_KEY=
BLUESANDAI_SSO_SAML_SP_CERT=
# 0: do not sign AuthnRequests (logout messages are always signed)
BLUESANDAI_SSO_SAML_SIGN_REQUESTS=
# where the browser lands after an identity provider's logout (default {web}/login; register it for OIDC providers)
BLUESANDAI_SSO_POST_LOGOUT_URL=

# --------------------------------------------------------------------------------------------
# AI models and parsing
# --------------------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_SERVER_URL=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DOCAI_PROJECT_ID=
GOOGLE_DOCAI_LOCATION=
GOOGLE_DOCAI_PROCESSOR_ID=
GOOGLE_DOCAI_PROCESSOR_VERSION=

# --------------------------------------------------------------------------------------------
# Storage (S3 for file contents and results; S3 Vectors for Vector Storage)
# --------------------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_S3_VECTOR_STORE_BUCKET_NAME=

# --------------------------------------------------------------------------------------------
# Servers
# --------------------------------------------------------------------------------------------
# where the web server's build runner reaches the API, and transforms call it
BLUESANDAI_API_URL=http://127.0.0.1:8000
# the web app's API address (web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Google Maps Platform (web/.env.local): basemap Google Satellite/Hybrid (Map Tiles API) + mode Google Earth 3D (Maps JavaScript API). Lihat docs/GOOGLE_MAPS.md
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
BLUESANDAI_DATA_DIR=
