# The LLM of the clinical review (stage 05). Gemini (generateContent) as in the judges' reference, or any
# OpenAI-compatible API (LLM_API_BASE_URL ending in /v1). Left empty: the deterministic fallback answers.
LLM_API_KEY=isi-api-key-anda-disini
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
LLM_MODEL_NAME=gemini-3.5-flash
LLM_TIMEOUT=30

# The exported model package (python export_paket.py writes ./paket)
PAKET_DIR=./paket
